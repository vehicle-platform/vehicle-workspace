# The 12 platform repos are independent git repos, cloned by setup.sh
/vehicle-*/
.DS_Store
.claude/settings.local.json
.claude/worktrees/
WORKTREES.md
# Generated by scripts/vscode_workspace.py (local paths, regenerated on every worktree change)
vehicle-platform.code-workspace
# Copyrighted ISO standard PDFs: never commit
docs-presentation/references/*.pdf
# The user's local thesis-presentation drafts and study notes (personal, not platform docs)
/docs-presentation/
/learning/
# Local APK builds (also matched by /vehicle-*/; listed so it stays ignored if that rule changes)
/vehicle-apk/
__pycache__/
# Manufacturer studio photos used as CAD references: copyrighted, never commit (D-033)
/models/hardware-integration/reference-images/
# AI-generated bike meshes (Meshy, 32 MB): large and their licence is unclear for a public repo (D-033)
/models/Meshy_AI_*
